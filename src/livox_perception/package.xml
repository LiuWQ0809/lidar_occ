<?xml version="1.0"?>
<package format="3">
  <name>livox_perception</name>
  <version>0.1.0</version>
  <description>Livox Mid-360 lidar occupancy grid perception pipeline with tracking optimized for Jetson Orin.</description>

  <maintainer email="liuwq@example.com">Liu WQ</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>

  <build_depend>pcl_msgs</build_depend>
  <build_depend>PCL</build_depend>
  <build_depend>Eigen3</build_depend>
  <build_depend>CUDA</build_depend>
  <build_depend>livox_ros_driver2</build_depend>

  <build_export_depend>PCL</build_export_depend>
  <build_export_depend>Eigen3</build_export_depend>
  <build_export_depend>CUDA</build_export_depend>
  <build_export_depend>livox_ros_driver2</build_export_depend>

  <exec_depend>PCL</exec_depend>
  <exec_depend>Eigen3</exec_depend>
  <exec_depend>CUDA</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
